# Copy to keystore.properties in the project root (gitignored — never commit the real file).
# The release keystore lives at: signing/mahava-release.jks
# Backup vault (same key): Desktop/release-signing-keys/mahava/
#
# Rebuild signed release:
#   gradlew.bat assembleRelease
#   gradlew.bat bundleRelease
storeFile=signing/mahava-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=mahava
keyPassword=YOUR_KEY_PASSWORD
