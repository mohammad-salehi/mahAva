<?xml version="1.0" encoding="utf-8"?>
<!-- Pink glass: translucent pink gradient, soft white top sheen, 1dp white inner edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#B8FCD3E4"
                android:centerColor="#B0F8B4CF"
                android:endColor="#A8F2A1BF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#5CFFFFFF"
                android:centerColor="#00FFFFFF"
                android:centerY="0.42"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>